# Vite fingerprints everything under /assets, so a changed file always gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files keep their URL when replaced, so they refresh within a day.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon-kana.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
