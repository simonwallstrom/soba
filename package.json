{
  "name": "soba",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "typecheck": "tsc -b tsconfig.json",
    "types:worker": "wrangler types --env-file .dev.vars.example",
    "types:check": "wrangler types --check --env-file .dev.vars.example",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "check": "bun run format:check && bun run lint && bun run types:check && bun run typecheck && bun run test",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@livestore/adapter-web": "0.4.0",
    "@livestore/livestore": "0.4.0",
    "@livestore/peer-deps": "0.4.0",
    "@livestore/react": "0.4.0",
    "@livestore/sync-cf": "0.4.0",
    "@livestore/wa-sqlite": "0.4.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.41",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.1.14",
    "oxc-transform-react": "0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.142.0"
  },
  "packageManager": "bun@1.4.2"
}
