{
  "name": "soba",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "cf workers types",
    "dev": "vite",
    "build": "bun run check && cf build",
    "preview": "vite preview",
    "deploy": "bun run build && bun run db:migrate:remote && cf deploy --prebuilt",
    "typecheck": "cf workers types && tsc -b tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 3c45797e-8236-4864-af08-a21627c98756 --dir drizzle/migrations --local --persist-to .cloudflare/state",
    "db:seed": "bun scripts/seed-local.ts",
    "import:compare": "bun scripts/compare-import-models.ts",
    "profile:compare": "bun scripts/compare-recipe-profiles.ts",
    "db:migrate:remote": "cf d1 migrations apply 3c45797e-8236-4864-af08-a21627c98756 --dir drizzle/migrations",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@base-ui/react": "1.8.0",
    "@livestore/adapter-web": "0.4.0",
    "@livestore/livestore": "0.4.0",
    "@livestore/peer-deps": "0.4.0",
    "@livestore/react": "0.4.0",
    "@livestore/sync-cf": "0.4.0",
    "@livestore/wa-sqlite": "0.4.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@valibot/to-json-schema": "1.8.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.41",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cf": "1.0.0-beta.5",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.1.14",
    "oxc-transform-react": "0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "packageManager": "bun@1.4.2"
}
