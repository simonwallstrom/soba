BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
AUTH_ALLOWED_EMAILS=you@example.com
# Recipe imports: an AI Gateway (https://gateway.ai.cloudflare.com/v1/<account>/<gateway>) and a
# gateway token with Run permission.
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/replace-with-account-id/default
AI_GATEWAY_TOKEN=replace-with-gateway-token
