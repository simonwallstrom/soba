{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".types/server",
    "tsBuildInfoFile": ".types/server.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["./.cloudflare/types/index.d.ts"]
  },
  "include": ["cloudflare.config.ts", "src/server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
